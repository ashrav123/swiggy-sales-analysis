-- ============================================================
-- Q1. WHERE IS REVENUE CONCENTRATED?
-- ============================================================

-- Business Objective:
-- Identify the states and cities contributing the highest
-- revenue to understand geographical revenue concentration.

-- SQL Concepts: INNER JOIN, GROUP BY, SUM, ORDER BY

SELECT
    l.state,
    l.city,
    SUM(s.price_inr) AS total_revenue
FROM dim_location l
JOIN fact_swiggy s
    ON s.location_id = l.location_id
GROUP BY
    l.state,
    l.city
ORDER BY total_revenue DESC;


-- ============================================================
-- Q2. WHAT IS OUR AVERAGE DEAL PRICE?
-- ============================================================

-- Business Objective:
-- Analyze the average dish price across different food
-- categories, cities, and individual dishes to understand
-- pricing variations.

-- SQL Concepts: Multiple INNER JOINS, GROUP BY, AVG, ORDER BY

SELECT
    c.category,
    l.city,
    d.dish_name,
    AVG(s.price_inr) AS average_price
FROM fact_swiggy s
JOIN dim_location l
    ON s.location_id = l.location_id
JOIN dim_dish d
    ON d.dish_id = s.dish_id
JOIN dim_category c
    ON s.category_id = c.category_id
GROUP BY
    c.category,
    l.city,
    d.dish_name
ORDER BY average_price DESC;


-- ============================================================
-- Q3. WHICH FOOD CATEGORIES ARE THE REVENUE ENGINE?
-- ============================================================

-- Business Objective:
-- Identify the highest revenue-generating food categories
-- and evaluate their contribution through order volume
-- and average selling price.

-- SQL Concepts: INNER JOIN, GROUP BY, COUNT, SUM, AVG, ROUND

SELECT
    c.category,
    COUNT(*) AS total_orders,
    SUM(f.price_inr) AS total_revenue,
    ROUND(AVG(f.price_inr), 2) AS average_price
FROM fact_swiggy f
JOIN dim_category c
    ON f.category_id = c.category_id
GROUP BY c.category
ORDER BY total_revenue DESC;


-- ============================================================
-- Q4. HOW DOES REVENUE CHANGE OVER TIME?
-- ============================================================

-- Business Objective:
-- Analyze revenue trends across quarters and months
-- to identify seasonal patterns and revenue fluctuations.

-- SQL Concepts: INNER JOIN, GROUP BY, SUM

SELECT
    d.quarter,
    d.month_name,
    SUM(f.price_inr) AS total_revenue
FROM fact_swiggy f
JOIN dim_date d
    ON f.date_id = d.date_id
GROUP BY
    d.quarter,
    d.month_name;


-- ============================================================
-- Q5. WHICH PRICE SEGMENT DRIVES THE MOST DEMAND,
--     AND WHICH HAS THE BEST RATINGS?
-- ============================================================

-- Business Objective:
-- Segment dishes into Budget, Mid, and Premium price
-- categories to compare transaction volume, total value,
-- average price, and customer ratings.

-- SQL Concepts: CASE WHEN, GROUP BY, COUNT, SUM, AVG, ROUND

SELECT
    CASE
        WHEN price_inr < 200 THEN 'Budget'
        WHEN price_inr BETWEEN 200 AND 500 THEN 'Mid'
        ELSE 'Premium'
    END AS price_segment,

    COUNT(*) AS total_records,

    ROUND(SUM(price_inr), 2) AS total_dish_value,

    ROUND(AVG(price_inr), 2) AS average_price,

    ROUND(AVG(rating), 2) AS average_rating,

    COUNT(rating) AS rated_records

FROM fact_swiggy

GROUP BY price_segment

ORDER BY average_rating DESC;


-- ============================================================
-- Q6. WHICH CITIES SHOULD BE PRIORITIZED FOR ACCOUNT
--     MANAGEMENT?
-- ============================================================

-- Business Objective:
-- Identify cities with above-average rating counts
-- to prioritize locations with stronger customer engagement
-- for potential account management opportunities.

-- SQL Concepts: CTEs, INNER JOIN, CROSS JOIN,
--               GROUP BY, AVG, SUM, WHERE

WITH city_demand AS (
    SELECT
        dl.state,
        dl.city,
        SUM(f.rating_count) AS total_demand
    FROM fact_swiggy f
    JOIN dim_location dl
        ON dl.location_id = f.location_id
    GROUP BY
        dl.state,
        dl.city
),

avg_demand AS (
    SELECT
        AVG(total_demand) AS avg_city_demand
    FROM city_demand
)

SELECT
    c.state,
    c.city,
    c.total_demand,
    ROUND(a.avg_city_demand, 0) AS avg_city_demand
FROM city_demand c
CROSS JOIN avg_demand a
WHERE c.total_demand > a.avg_city_demand
ORDER BY c.total_demand DESC;


-- ============================================================
-- Q7. WHICH CITIES GENERATE THE HIGHEST REVENUE?
-- ============================================================

-- Business Objective:
-- Compare revenue generated across cities to identify
-- the strongest geographical revenue contributors.

-- SQL Concepts: INNER JOIN, GROUP BY, SUM, ORDER BY

SELECT
    l.city,
    SUM(f.price_inr) AS total_revenue
FROM fact_swiggy f
JOIN dim_location l
    ON f.location_id = l.location_id
GROUP BY l.city
ORDER BY total_revenue DESC;


-- ============================================================
-- Q8. WHICH CITIES AND STATES HAVE THE BEST
--     OVERALL SALES PERFORMANCE?
-- ============================================================

-- Business Objective:
-- Evaluate geographical performance using total order
-- volume, total revenue, and average order value.

-- SQL Concepts: INNER JOIN, GROUP BY, COUNT,
--               SUM, AVG, ROUND, ORDER BY

SELECT
    l.state,
    l.city,
    COUNT(f.order_id) AS total_orders,
    SUM(f.price_inr) AS total_revenue,
    ROUND(AVG(f.price_inr), 2) AS avg_order_value
FROM fact_swiggy f
JOIN dim_location l
    ON f.location_id = l.location_id
GROUP BY
    l.state,
    l.city
ORDER BY total_revenue DESC;


-- ============================================================
-- Q9. WHAT ARE THE TOP 3 REVENUE-GENERATING DISHES
--     WITHIN EACH FOOD CATEGORY?
-- ============================================================

-- Business Objective:
-- Rank dishes within each food category based on revenue
-- to identify the best-performing dishes and restaurants.

-- SQL Concepts: CTEs, Multiple INNER JOINS, GROUP BY,
--               DENSE_RANK(), PARTITION BY, Window Functions

WITH dish_revenue AS (
    SELECT
        c.category,
        d.dish_name,
        r.restaurant_name,
        SUM(f.price_inr) AS total_revenue,
        COUNT(f.order_id) AS total_orders
    FROM fact_swiggy f
    JOIN dim_dish d
        ON f.dish_id = d.dish_id
    JOIN dim_category c
        ON f.category_id = c.category_id
    JOIN dim_restaurant r
        ON f.restaurant_id = r.restaurant_id
    GROUP BY
        c.category,
        d.dish_name,
        r.restaurant_name
),

ranked_dishes AS (
    SELECT
        *,
        DENSE_RANK() OVER (
            PARTITION BY category
            ORDER BY total_revenue DESC
        ) AS dish_rank
    FROM dish_revenue
)

SELECT
    category,
    dish_name,
    restaurant_name,
    total_revenue,
    total_orders,
    dish_rank
FROM ranked_dishes
WHERE dish_rank <= 3
ORDER BY
    category,
    dish_rank;


